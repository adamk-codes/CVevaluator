<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.apliman</groupId>
	<artifactId>cvevaluator</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- Neither of these is managed by the Spring Boot 4.1 BOM, so the versions
		     are pinned here by hand. Checked: no <pdfbox> or <poi> entry exists in
		     spring-boot-dependencies. -->
		<pdfbox.version>3.0.5</pdfbox.version>
		<poi.version>5.4.1</poi.version>
		<spring-ai.version>2.0.0</spring-ai.version>
	</properties>

	<!-- Spring AI ships its own BOM; it is not part of spring-boot-dependencies.
	     Every spring-ai-* artifact below therefore takes its version from here and
	     none carry one inline. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Authentication and authorisation. Two artifacts, and the second one is
		     the non-obvious half:

		     - starter-security brings the filter chain, the lambda DSL, method
		       security and BCryptPasswordEncoder.
		     - starter-security-oauth2-resource-server brings the bearer-token
		       filter AND spring-security-oauth2-jose, which is where
		       NimbusJwtEncoder and NimbusJwtDecoder live. Those are what sign and
		       verify our own tokens.

		     No third-party JWT library (jjwt, auth0) is on the classpath and none
		     is needed: "OAuth2 resource server" here means only "reads a bearer
		     token", not "talks to an authorization server". We are our own issuer,
		     with a symmetric HMAC key - see SecurityConfig.

		     Note the Boot 4 artifact naming. It is spring-boot-starter-security-
		     oauth2-resource-server, not the Boot 3 spring-boot-starter-oauth2-
		     resource-server. Both ids resolve from the 4.1 BOM; the first matches
		     the modular naming the rest of this file already uses. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
		</dependency>

		<!-- Text extraction. PDFBox 3 logs through SLF4J natively; POI logs through
		     log4j-api, which spring-boot-starter-logging already bridges to Logback
		     via log4j-to-slf4j, so no extra wiring is needed. -->
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>${pdfbox.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>${poi.version}</version>
		</dependency>

		<!-- Evaluation. Only the Developer-API key is ever configured for this
		     starter - see the Gemini note in CLAUDE.md: adding project-id or
		     location flips the client into Vertex AI mode and the key is rejected. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-google-genai</artifactId>
		</dependency>

		<!-- Harness only, and test scope is what enforces that. Gemini's free
		     tier cannot complete a 60-pair run - it 429s partway through - so
		     the measurement runs need a provider whose quota can finish one.
		     Production stays on Gemini: this artifact is absent from the
		     runtime classpath, so its autoconfiguration cannot load there even
		     if a property were set by accident. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-anthropic</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
